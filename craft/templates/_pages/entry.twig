{% extends '_layout' %}
{% from '_partials/icons.twig' import icon %}
{% import '_partials/ui.twig' as ui %}

{% block content %}
{%- set s = siteSettings -%}
{%- set crumbs = entry.parent ? [{title: entry.parent.title, url: entry.parent.url}, {title: entry.title}] : [{title: entry.title}] -%}
{#- A page with sub-pages uses its "heading" as its own nav label (e.g. Despre noi → Scurt istoric); show it as the banner title. -#}
{%- set isHub = entry.heading and entry.children.exists() and entry.type.handle == 'page' -%}
{{ ui.pageHero(isHub ? entry.heading : entry.title, crumbs) }}

{%- set intro -%}
  {% if entry.heading and not isHub %}<h2>{{ entry.heading }}</h2>{% endif %}{{ entry.body }}
{%- endset -%}

{% switch entry.type.handle %}

{# ------------------------------------------------------------ specialties index #}
{% case 'specialtiesIndex' %}
<section class="section bg-soft"><div class="container">
  {% if intro|trim %}<div class="prose" style="margin-bottom:30px">{{ intro }}</div>{% endif %}
  <div class="grid g4">{% for sp in craft.entries.section('specialties').ambulatoryOnly('not 1').all() %}{{ ui.specCard(sp) }}{% endfor %}</div>
  <div class="center mt-40">
    {% for child in entry.children.all() %}<a class="btn btn-primary" href="{{ child.url }}">{{ child.title }}</a> {% endfor %}
    <a class="btn btn-outline" style="color:var(--primary)" href="{{ ui.pageUrl('ambulatoriu') }}">Ambulatoriu de specialitate</a>
  </div>
  {{ ui.blocks(entry.contentBlocks.all()) }}
</div></section>

{# ------------------------------------------------------------ outpatient index #}
{% case 'ambulatoryIndex' %}
<section class="section"><div class="container">
  <div class="section-head">{% if entry.heading %}<h2>{{ entry.heading }}</h2>{% endif %}{{ entry.body }}</div>
  <div class="grid g2" style="max-width:860px;margin:0 auto 50px">
    <div class="info-box" style="margin:0"><span class="ring">{{ icon('phone') }}</span><div><small>Centrală</small><strong>{{ s.phone }}</strong></div></div>
    {% if s.bookingUrl %}<a class="info-box" style="margin:0" href="{{ s.bookingUrl }}" target="_blank" rel="noopener"><span class="ring">{{ icon('calendar') }}</span><div><small>Programări online</small><strong>{{ s.bookingUrl|replace('/^https?:\\/\\/([^\\/]+).*$/', '$1') }}</strong></div></a>{% endif %}
  </div>
  <div class="grid g3">
  {%- for sp in craft.entries.section('specialties').hasAmbulatory(true).all() -%}
    <a class="card" href="{{ sp.url }}#ambulatoriu"><div class="card-icon">{{ icon(sp.iconName.value) }}</div><h3>Cabinet {{ sp.title }}</h3>
      <ul class="cb-list dark">{% for x in sp.ambProgram %}<li>{{ icon('clock') }}<span>{{ x.text }}</span></li>{% endfor %}{% for x in sp.ambPhones|slice(0, 2) %}<li>{{ icon('phone') }}<span>{{ x.text }}</span></li>{% endfor %}</ul>
      <span class="read-more">Medici și program →</span></a>
  {%- endfor -%}
  </div>
  {{ ui.blocks(entry.contentBlocks.all()) }}
</div></section>

{# ------------------------------------------------------------ doctors index #}
{% case 'doctorsIndex' %}
{%- set groups = [] -%}
{%- for sp in craft.entries.section('specialties').all() -%}
  {%- set ds = craft.entries.section('doctors').relatedTo({targetElement: sp, field: 'specialty'}).all() -%}
  {%- if ds|length %}{% set groups = groups|merge([{sp: sp, ds: ds}]) %}{% endif -%}
{%- endfor -%}
<section class="section"><div class="container">
  {% if intro|trim %}<div class="prose" style="margin-bottom:30px">{{ intro }}</div>{% endif %}
  <div class="filters" id="teamFilters"><button class="active" data-filter="all">Toți</button>{% for g in groups %}<button data-filter="{{ g.sp.slug }}">{{ g.sp.title }}</button>{% endfor %}</div>
  {% for g in groups %}
    <div class="team-group" data-group="{{ g.sp.slug }}"><h2><a href="{{ g.sp.url }}">{{ g.sp.title }}</a></h2><div class="grid g4">{% for d in g.ds %}{{ ui.doctorCard(d) }}{% endfor %}</div></div>
  {% endfor %}
</div></section>

{# ------------------------------------------------------------ news index #}
{% case 'newsIndex' %}
{%- set posts = craft.entries.section('news').all() -%}
<section class="section"><div class="container with-sidebar right">
  <div>{% if intro|trim %}<div class="prose" style="margin-bottom:30px">{{ intro }}</div>{% endif %}<div class="grid g2">{% for n in posts %}{{ ui.postCard(n) }}{% endfor %}</div></div>
  {% include '_partials/news-sidebar' %}
</div></section>

{# ------------------------------------------------------------ prices #}
{% case 'pricesPage' %}
{%- set groups = craft.entries.section('priceGroups').all() -%}
<section class="section"><div class="container with-sidebar right">
  <div class="prose">
    {% if entry.heading %}<h2>{{ entry.heading }}</h2>{% endif %}
    {{ ui.blocks(entry.contentBlocks.all()) }}
    <div class="muted">{{ entry.body }}</div>
    <div class="info-box"><span class="ring">{{ icon('phone') }}</span><div><small>Informații și programări</small><strong>{{ s.phone }}</strong></div></div>
    <div class="filter-input"><input type="search" id="priceFilter" placeholder="Caută un serviciu (ex.: hemoleucogramă, CT, ecografie)…" aria-label="Caută în tarife"></div>
    <div id="priceAccordion">{{ ui.accordion(groups|map(g => {
      q: g.title ~ ' (' ~ g.priceItems|length ~ ')',
      a: '<div class="table-wrap"><table><thead><tr><th>Serviciu</th><th style="text-align:right">Tarif</th></tr></thead><tbody>' ~ g.priceItems|map(r => '<tr><td>' ~ r.service|e ~ '</td><td class="price">' ~ r.price|e ~ '</td></tr>')|join ~ '</tbody></table></div>'
    }), false) }}</div>
  </div>
  <aside class="sidebar">{{ ui.contactBox() }}</aside>
</div></section>

{# ------------------------------------------------------------ public interest #}
{% case 'publicInterest' %}
{%- set groups = craft.entries.section('documentGroups').all() -%}
<section class="section tiles-bg"><div class="container"><div class="grid g4">
  {%- for g in groups -%}
    {%- set linked = g.linkedPage.one() -%}
    {%- set count = g.documents.count() + (g.docLinks ?: [])|filter(l => l.url)|length -%}
    {%- if linked %}{% set href = linked.url %}{% set label = 'Vezi pagina' %}
    {%- elseif count %}{% set href = '#doc-' ~ g.slug %}{% set label = count ~ (count == 1 ? ' document' : ' documente') %}
    {%- elseif g.linkUrl %}{% set href = g.linkUrl %}{% set label = 'Vezi documentele' %}
    {%- else %}{% set href = null %}{% endif -%}
    {%- if href -%}
    <a class="card tile" href="{{ href }}"{% if href matches '/^https?:/' %} target="_blank" rel="noopener"{% endif %} data-open="{{ href starts with '#' ? href|slice(1) }}"><div class="card-icon">{{ icon(g.iconName.value) }}</div><h3>{{ g.title }}</h3><span class="btn btn-primary btn-sm">{{ label }}</span></a>
    {%- endif -%}
  {%- endfor -%}
</div></div></section>
<section class="section"><div class="container"><h2 class="h2">Documente</h2><div class="accordion" id="docsAccordion">
  {%- for g in groups -%}
    {%- set count = g.documents.count() + (g.docLinks ?: [])|filter(l => l.url)|length -%}
    {%- if count and not g.linkedPage.exists() -%}
    <details id="doc-{{ g.slug }}"><summary>{{ g.title }} <small>({{ count }})</small></summary><div class="acc-body">{% if g.note %}<p class="muted">{{ g.note }}</p>{% endif %}{{ ui.docList(g.documents.all(), g.docLinks) }}</div></details>
    {%- endif -%}
  {%- endfor -%}
</div></div></section>
<section class="section bg-soft"><div class="container">
  {% if entry.heading %}<h2 class="h2">{{ entry.heading }}</h2>{% endif %}
  {{ entry.body }}
  <div class="req-grid" style="grid-template-columns:repeat(3,1fr);margin-top:24px">
    <div class="req">{{ icon('mail') }}<div><strong>Email</strong>{{ s.email }}<br>{{ s.emailOffice }}</div></div>
    <div class="req">{{ icon('phone') }}<div><strong>Telefon</strong>{{ s.phone }}{% if s.fax %}<br>Fax: {{ s.fax }}{% endif %}</div></div>
    <div class="req">{{ icon('building') }}<div><strong>Depus la Registratura Spitalului</strong>{{ s.addressShort }}</div></div>
  </div>
  {{ ui.blocks(entry.contentBlocks.all()) }}
</div></section>

{# ------------------------------------------------------------ contact #}
{% case 'contactPage' %}
{%- set book = s.bookingUrl ?: '#programari' -%}
<section class="section"><div class="container">
  <div class="section-head"><h2>{{ s.legalName }}</h2><p>{{ s.address }}</p></div>
  <div class="grid g4 contact-cards">
    <div class="card"><div class="card-icon">{{ icon('phone') }}</div><h3>Telefon</h3><p><a href="tel:{{ ui.tel(s.phone) }}">{{ s.phone }}</a>{% if s.fax %}<br>Fax: {{ s.fax }}{% endif %}</p></div>
    <div class="card"><div class="card-icon">{{ icon('calendar') }}</div><h3>Programări</h3><p>{% if s.phoneAppointments %}<a href="tel:{{ ui.tel(s.phoneAppointments) }}">{{ s.phoneAppointments }}</a><br>{% endif %}<a href="{{ book }}" target="_blank" rel="noopener">Programări online</a></p></div>
    <div class="card"><div class="card-icon">{{ icon('mail') }}</div><h3>Email</h3><p><a href="mailto:{{ s.email }}">{{ s.email }}</a>{% if s.emailOffice %}<br><a href="mailto:{{ s.emailOffice }}">{{ s.emailOffice }}</a>{% endif %}</p></div>
    <div class="card"><div class="card-icon">{{ icon('people') }}</div><h3>Audiențe management</h3><p>{% for a in s.audiences %}{{ a.text }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p></div>
  </div>
</div></section>
<section class="section bg-soft" id="programari"><div class="container split" style="align-items:start">
  <div class="prose">
    <span class="eyebrow">Programări</span><h2 class="h2">Cum te programezi</h2>
    <div class="info-box"><span class="ring">{{ icon('phone') }}</span><div><small>Centrală – apoi tasta secției dorite</small><strong>{{ s.phone }}</strong></div></div>
    {% if s.phoneAppointments %}<div class="info-box"><span class="ring">{{ icon('calendar') }}</span><div><small>Programări</small><strong>{{ s.phoneAppointments }}</strong></div></div>{% endif %}
    <a class="btn btn-primary" href="{{ book }}" target="_blank" rel="noopener">Programări online {{ icon('external') }}</a>
    {{ ui.blocks(entry.contentBlocks.all()) }}
  </div>
  <div class="form-card"><h3>Mass-media</h3><p>Purtător de cuvânt: {{ s.spokesperson }}</p><h3>Integritate</h3><p>Sesizări: <a href="mailto:{{ s.emailIntegrity }}">{{ s.emailIntegrity }}</a></p>
  <h3>Concursuri / Resurse umane</h3><p>{{ s.phoneHr }} (R.U.N.O.S.)</p></div>
</div></section>
<section class="section"><div class="container">
  <iframe class="map" title="Hartă – {{ s.legalName }}" loading="lazy" src="https://maps.google.com/maps?q={{ s.mapQuery|url_encode }}&output=embed"></iframe>
  <div class="grid g3 transport" style="margin-top:30px">{% for t in s.transport %}<div class="card"><div class="card-icon">{{ icon(t.icon) }}</div><h3>{{ t.label }}</h3><p>{{ t.text }}</p></div>{% endfor %}</div>
</div></section>

{# ------------------------------------------------------------ generic page #}
{% default %}
{%- set blocks = entry.contentBlocks.all() -%}
{%- set wide = blocks|filter(b => b.type.handle in ['blockCards', 'blockMedia'])|length > 0 -%}
{% if wide %}
  {% if intro|trim %}<section class="section-sm"><div class="container prose">{{ intro }}</div></section>{% endif %}
  {{ ui.wideBlocks(blocks) }}
{% else %}
  <section class="section"><div class="container">
    <div class="with-sidebar right"><div class="prose">{{ intro }}{{ ui.blocks(blocks) }}</div><aside class="sidebar">{{ ui.contactBox() }}</aside></div>
  </div></section>
{% endif %}
{% endswitch %}
{% endblock %}
