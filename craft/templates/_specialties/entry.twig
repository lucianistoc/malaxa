{% extends '_layout' %}
{% from '_partials/icons.twig' import icon %}
{% import '_partials/ui.twig' as ui %}
{% set description = entry.summary %}

{% block content %}
{%- set index = craft.entries.section('pages').type('specialtiesIndex').one() -%}
{{ ui.pageHero(entry.title, [{title: index.title ?? 'Specialități medicale', url: index.url ?? null}, {title: entry.title}]) }}
{%- set team = craft.entries.section('doctors').relatedTo({targetElement: entry, field: 'specialty'}).all() -%}
<section class="section"><div class="container with-sidebar">
  <aside class="sidebar">
    <nav class="side-menu" aria-label="Specialități medicale"><h3>{{ index.title ?? 'Specialități medicale' }}</h3><ul>
      {%- for x in craft.entries.section('specialties').all() %}<li><a class="{{ x.id == entry.id ? 'active' }}" href="{{ x.url }}">{{ x.title }}</a></li>{% endfor -%}
    </ul></nav>
    {{ ui.contactBox(entry.phones, entry.hours) }}
  </aside>
  <div class="prose">
    {% if entry.beds %}<p class="pill">{{ icon('hospital') }} {{ entry.beds }}</p>{% endif %}
    {{ entry.body ?: '<p>' ~ entry.summary|e ~ '</p>' }}
    {% if team|length %}<h2>Echipa medicală</h2><div class="grid g3 team-grid">{% for d in team %}{{ ui.doctorCard(d) }}{% endfor %}</div>{% endif %}
    {{ ui.blocks(entry.contentBlocks.all()) }}
    {% if entry.equipment|length %}<h3>Dotări</h3>{{ ui.list(entry.equipment, entry.equipment|length > 5 ? 'list-check cols' : 'list-check') }}{% endif %}
    {% for l in entry.docLinks %}{% if l.url %}<p>{{ ui.docLink(l.title, l.url, 'btn btn-primary') }}</p>{% endif %}{% endfor %}

    {% if entry.hasAmbulatory %}
    <div class="amb-block" id="ambulatoriu"><h2>Ambulatoriu de specialitate</h2>
      {{ ui.paras(entry.ambIntro) }}
      {% for x in entry.ambProgram %}<div class="info-box"><span class="ring">{{ icon('clock') }}</span><div><small>Program</small><strong>{{ x.text }}</strong></div></div>{% endfor %}
      {% if entry.ambPhones|length %}{{ ui.list(entry.ambPhones, 'list-plain') }}{% endif %}
      {% if entry.ambSchedule|length %}
        <div class="table-wrap"><table><thead><tr><th>Medic</th><th>Program</th></tr></thead><tbody>{% for r in entry.ambSchedule %}<tr><td><strong>{{ r.doctor }}</strong></td><td>{{ r.program }}</td></tr>{% endfor %}</tbody></table></div>
      {% endif %}
      {% if entry.ambServices|length %}<h4>Servicii în ambulatoriu</h4>{{ ui.list(entry.ambServices) }}{% endif %}
      <h4>Documente necesare</h4>
      {{ ui.list(['Bilet de trimitere de la medicul de familie / medic specialist în contract cu casa de asigurări', 'Cardul de sănătate', 'Dovada calității de asigurat', 'CI / BI / Pașaport, original și xerocopie']) }}
    </div>
    {% endif %}

    {% if entry.gallery.exists() %}<h2>Galerie foto</h2>{{ ui.gallery(entry.gallery.all()) }}{% endif %}

    {% set pg = entry.priceGroup.one() %}
    {% if pg %}
      {% set pricesPage = craft.entries.section('pages').type('pricesPage').one() %}
      <h2>Servicii medicale cu plată</h2>
      {% set note = pricesPage ? pricesPage.contentBlocks.type('blockNotice').one() : null %}
      {% if note %}<p class="muted">{{ note.note }}</p>{% endif %}
      <details class="price-toggle"><summary>Vezi tarifele ({{ pg.priceItems|length }} servicii)</summary><div class="table-wrap"><table><thead><tr><th>Serviciu</th><th style="text-align:right">Tarif</th></tr></thead><tbody>
        {% for r in pg.priceItems %}<tr><td>{{ r.service }}</td><td class="price">{{ r.price }}</td></tr>{% endfor %}
      </tbody></table></div></details>
    {% endif %}
  </div>
</div></section>
{% endblock %}
