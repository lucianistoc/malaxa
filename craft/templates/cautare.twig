{% extends '_layout' %}
{% import '_partials/ui.twig' as ui %}
{% set q = craft.app.request.getQueryParam('q')|trim %}
{% set pageTitle = 'Căutare' %}

{% block content %}
{{ ui.pageHero('Căutare', [{title: 'Căutare'}]) }}
{%- set results = q ? craft.entries.section(['pages', 'hospital', 'ambulatory', 'doctors', 'news']).search(q).orderBy('score').limit(60).all() : [] -%}
<section class="section"><div class="container" style="max-width:860px">
  <form class="search-form" action="" role="search"><input type="search" name="q" value="{{ q }}" aria-label="Caută"><button class="btn btn-primary" type="submit">Caută</button></form>
  <div class="results" aria-live="polite">
    {%- for r in results -%}
      <a href="{{ r.url }}"><strong>{{ r.title }}</strong><br><small>{{ r.section.name }}</small></a>
    {%- else -%}
      <p class="muted">{{ q ? 'Nu am găsit rezultate pentru „' ~ q ~ '”.' : 'Introduceți un termen de căutare.' }}</p>
    {%- endfor -%}
  </div>
</div></section>
{% endblock %}
