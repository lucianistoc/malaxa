{% extends '_layout' %}
{% from '_partials/icons.twig' import icon %}
{% import '_partials/ui.twig' as ui %}
{%- set sec = entry.hospitalUnit.one() -%}
{%- set cab = entry.cabinet.one() -%}
{%- set primary = sec ?? cab -%}
{% set description = entry.title ~ (entry.grade ? ' – ' ~ entry.grade) %}

{% block content %}
{%- set photo = entry.photo.one() -%}
{#- Outpatient schedule row for this doctor in the cabinet's "Program medici" table, matched on the surname. -#}
{%- set surname = (entry.title|replace('/^(Dr\\.|Biol\\.|Psiholog)\\s*/', '')|split(' ')|first) -%}
{%- set amb = null -%}
{%- for r in cab.schedule ?? [] -%}
  {%- if amb is null and surname and surname in r.doctor %}{% set amb = r.program %}{% endif -%}
{%- endfor -%}
<section class="section"><div class="container profile">
  <div>
    <div class="doctor-photo">{% if photo %}<img src="{{ photo.url }}" alt="{{ entry.title }}">{% else %}<span class="initials">{{ ui.initials(entry.title) }}</span>{% endif %}</div>
    {% if primary %}<div class="profile-spec">{{ primary.title }}</div>{% endif %}
    {{ ui.contactBox(primary.phones ?? []) }}
  </div>
  <div class="prose">
    <h1>{{ entry.title }}</h1>
    {% if entry.role %}<p class="pill">{{ entry.role }}</p>{% endif %}
    {% if entry.grade %}<p class="grade">{{ entry.grade }}</p>{% endif %}
    {{ ui.paras(entry.bio) }}
    {% if amb %}<div class="info-box"><span class="ring">{{ icon('clock') }}</span><div><small>Program în ambulatoriu</small><strong>{{ amb }}</strong></div></div>{% endif %}
    <p class="hero-actions">
      {%- if sec %}<a class="btn btn-primary" href="{{ sec.url }}">Spital: {{ sec.title }} {{ icon('arrow') }}</a>{% endif -%}
      {%- if cab %}<a class="btn btn-outline" style="color:var(--primary)" href="{{ cab.url }}">Ambulatoriu: {{ cab.title }} {{ icon('arrow') }}</a>{% endif -%}
    </p>
  </div>
</div></section>
{% endblock %}
